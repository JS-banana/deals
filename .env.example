# Copy to .env. Compose reads this file, and the pnpm dev/worker/db scripts load it.

# Postgres (compose creates the database with these credentials)
POSTGRES_PASSWORD=change-me
# Local dev only; inside compose the services get their own URL.
DATABASE_URL=postgres://deals:change-me@127.0.0.1:54329/deals

# Public origin used for canonical URLs, sitemap and RSS
SITE_URL=https://deals.laifuyou.com
# Optional GA4 web stream ID (G-...). Turn off enhanced measurement before enabling:
# the web app sends page views itself and excludes site searches from Analytics.
# In the stream's data redaction settings, redact email addresses and the q URL parameter.
GA_MEASUREMENT_ID=
# Optional: IndexNow key (e.g. `openssl rand -hex 16`). The web serves it at /<key>.txt and
# the worker submits changed pages to Bing and other IndexNow engines hourly. Leave empty locally.
INDEXNOW_KEY=
# Host port the web container binds on 127.0.0.1
WEB_PORT=3100
# Absolute directory for downloaded product logos (compose mounts a volume at /data/media)
MEDIA_DIR=/absolute/path/to/.data/media

# Review console (/admin), HTTP Basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# OpenAI-compatible chat completions endpoint used by the worker (GLM, DeepSeek, ...)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# Optional JSON merged into every request body (default disables GLM thinking: {"thinking":{"type":"disabled"}})
LLM_EXTRA_BODY=

# Optional: a separate (stronger) model for the English translation job. Set all three, or none to
# reuse LLM_* above. api.openai.com is detected and sent max_completion_tokens / reasoning_effort.
TRANSLATE_BASE_URL=https://api.openai.com/v1
TRANSLATE_API_KEY=
TRANSLATE_MODEL=gpt-5.5
# Optional JSON merged into every translation request body (default: none)
TRANSLATE_EXTRA_BODY=

# Proposal audit. If the review provider is incomplete the worker reuses the translation provider.
REVIEW_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=
REVIEW_EXTRA_BODY=
# Shadow decisions are always recorded. Each switch enables the corresponding real action.
AUTO_APPROVE_CREATE=false
AUTO_APPROVE_UPDATE=false
AUTO_REJECT_ENABLED=false
AUTO_APPROVE_MIN_SCORE=85
AUTO_REJECT_BELOW=60

# Optional: raises GitHub API rate limits for the upstream sync
GITHUB_TOKEN=

# nginx overwrites X-Real-IP. Generate a dedicated random secret before accepting anonymous writes.
COMMUNITY_HASH_SECRET=
# Source quotas/defaults and all individual SOURCE_<ID>_ENABLED switches are in sources/registry.json.
SOURCE_GITHUB_BFCM_ENABLED=true
SOURCE_JETBRAINS_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
RSSHUB_BASE_URL=
SEARCH_API_PROVIDER=brave
SEARCH_API_KEY=
# Optional operator digest. kind: slack, discord, feishu, wecom or dingtalk.
NOTIFY_WEBHOOK_KIND=slack
NOTIFY_WEBHOOK_URL=
# Optional high-value published offers, one subscription per configured group.
GROUP_WEBHOOK_SLACK_URL=
GROUP_WEBHOOK_DISCORD_URL=
GROUP_WEBHOOK_FEISHU_URL=
GROUP_WEBHOOK_WECOM_URL=
GROUP_WEBHOOK_DINGTALK_URL=
