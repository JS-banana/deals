# Copy to .env. Compose reads this file; local dev scripts source it.

# Postgres (compose creates the database with these credentials)
POSTGRES_PASSWORD=change-me
# Local dev only; inside compose the services get their own URL.
DATABASE_URL=postgres://deals:change-me@127.0.0.1:54329/deals

# Public origin used for canonical URLs, sitemap and RSS
SITE_URL=https://deals.laifuyou.com
# Host port the web container binds on 127.0.0.1
WEB_PORT=3100
# Absolute directory for downloaded product logos (compose mounts a volume at /data/media)
MEDIA_DIR=/absolute/path/to/.data/media

# Review console (/admin), HTTP Basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# OpenAI-compatible chat completions endpoint used by the worker (GLM, DeepSeek, ...)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

# Optional: raises GitHub API rate limits for the upstream sync
GITHUB_TOKEN=
